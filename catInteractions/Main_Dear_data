Table table;
ArrayList<Paw> paws = new ArrayList<Paw>();




void setup() {
  size(800, 800);
  table = loadTable("cat-interactions.csv", "header");
  for (TableRow row : table.rows()) {
    paws.add(new Paw(row.getInt(0), row.getString("Day"), row.getString("Time"), row.getInt("interactions")));
  }
  println(paws.size());
}

void draw() {
  background(255);
  for (Paw p : paws) {
    p.display();
  }

  pushMatrix();
  translate(400, 400);
  scale(1);
  translate(-400, -400);
  popMatrix();
}










